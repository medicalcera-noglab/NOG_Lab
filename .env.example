# ─────────────────────────────────────────────────────────────────────────────
# NOG Lab — Environment Variables
# Copy to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────────────────────
# Payload CMS secret — min 32 random chars, used to sign tokens + TOTP challenges
# Generate: openssl rand -base64 32
PAYLOAD_SECRET=your-payload-secret-here-min-32-chars

# Neon POOLED connection string — used by the running app (PgBouncer transaction mode)
DATABASE_URL=postgresql://user:pass@ep-xxx.pooler.neon.tech/noglab?sslmode=require

# Neon DIRECT connection string — used by `npx payload migrate` only (bypasses PgBouncer)
DIRECT_URL=postgresql://user:pass@ep-xxx.neon.tech/noglab?sslmode=require

# Canonical public URL — no trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Cloudflare R2 Storage ────────────────────────────────────────────────────
# Obtain from: Cloudflare dashboard → R2 → your bucket → API tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=noglab-media
# Public CDN URL for the media bucket — no trailing slash
# Example: https://pub-abc123.r2.dev  OR  https://media.noglab.org (custom domain)
R2_PUBLIC_URL=https://pub-XXXXXXXX.r2.dev

# ── Transactional Email — Resend ─────────────────────────────────────────────
RESEND_API_KEY=re_xxxx
# Verified sender address (must match a domain verified in Resend)
EMAIL_FROM=NOG Lab <noreply@noglab.org>
EMAIL_REPLY_TO=team@noglab.org

# ── TOTP Two-Factor Auth ──────────────────────────────────────────────────────
# 32-byte hex key for AES-256-GCM encryption of TOTP secrets at rest
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=your-32-byte-hex-key-here

# ── reCAPTCHA v3 ─────────────────────────────────────────────────────────────
# Register at https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# ── Crossref Polite Pool ──────────────────────────────────────────────────────
# Your contact email — included in User-Agent for Crossref requests
CROSSREF_CONTACT=team@noglab.org

# ── Scheduled Jobs ────────────────────────────────────────────────────────────
# Long random string shared between GitHub Actions secrets and cron route handlers
# Generate: openssl rand -base64 32
CRON_SECRET=your-cron-secret-here

# ── Rate Limiting — Upstash Redis ────────────────────────────────────────────
# Create a free Redis DB at https://console.upstash.com
# Leave blank in local dev — rate limiting is a no-op when these are unset
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Demo media seed ───────────────────────────────────────────────────────────
# Used by `npm run seed:demo-media` to download free-license imagery.
# Wikimedia Commons is queried without a key (no sign-up needed).
# Unsplash:  https://unsplash.com/developers  (free tier: 50 req/hr)
UNSPLASH_ACCESS_KEY=your-unsplash-access-key
# Pexels:    https://www.pexels.com/api/      (free, generous rate limit)
PEXELS_API_KEY=your-pexels-api-key

# ── Analytics (optional) ──────────────────────────────────────────────────────
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=noglab.org
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
