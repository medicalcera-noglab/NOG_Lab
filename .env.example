# ─────────────────────────────────────────────
# NOG Lab — Environment Variables
# Copy to .env.local and fill in real values.
# Never commit .env.local or any file with real secrets.
# ─────────────────────────────────────────────

# PostgreSQL connection string (with PostGIS extension enabled on the DB)
# Local example: postgresql://postgres:password@localhost:5432/noglab
DATABASE_URI=postgresql://USER:PASSWORD@HOST:5432/DB_NAME

# Payload CMS secret — min 32 random chars, used to sign tokens
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=your-payload-secret-here-min-32-chars

# Canonical public URL of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Node environment — set to "production" in production
NODE_ENV=development

# ── Transactional Email (Resend) ──────────────────────────────────────────────
# Obtain at https://resend.com — leave blank in dev to use ethereal test transport
RESEND_API_KEY=
# Verified sender address (must match a verified domain in Resend)
EMAIL_FROM=NOG Lab <noreply@noglab.org>

# ── TOTP Two-Factor Auth ──────────────────────────────────────────────────────
# 32-byte hex key used to encrypt TOTP secrets at rest (AES-256-GCM)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=your-32-byte-hex-key-here
